# Local development template only. Production settings belong in the host's secret manager.
# PostgreSQL connection settings (replace placeholders locally)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# JWT signing key (generate a private random value of at least 32 bytes)
JWT_SECRET=<generate-a-random-secret-of-at-least-32-bytes>

# API server
PORT=3000
NODE_ENV=development

# Vite client API base URL
VITE_API_URL=http://localhost:3000

# For production, leave VITE_API_URL unset when client and /api share one HTTPS origin.
# Never put server credentials or secrets in VITE_* variables; they are public build values.
